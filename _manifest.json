{
  "manifest_version": 2,
  "id": "bdbmzwsc.maibot-chat-summary-plugin",
  "version": "1.1.0",
  "name": "聊天总结",
  "description": "根据群聊/私聊历史记录，调用大模型生成聊天总结。",
  "author": {
    "name": "雪碧",
    "url": "https://github.com/Bdbmzwsc"
  },
  "license": "GPLv3",
  "urls": {
    "repository": "https://github.com/Bdbmzwsc/maibot-chat-summary-plugin",
    "homepage": "https://github.com/Bdbmzwsc/maibot-chat-summary-plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "extension",
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
